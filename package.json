{
  "name": "trpg-booth-search",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"fixtures/**/*.ts\" \"src/**/*.ts\" drizzle.config.ts eslint.config.mjs next.config.ts package.json tsconfig.json",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"fixtures/**/*.ts\" \"src/**/*.ts\" drizzle.config.ts eslint.config.mjs next.config.ts package.json tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --name=stage9_initial",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite-tools": "0.4.4",
    "@types/node": "24.1.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.32.0",
    "eslint-config-next": "16.2.12",
    "prettier": "3.6.2",
    "typescript": "npm:@typescript/typescript6@6.0.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  },
  "engines": {
    "node": ">=24 <25"
  }
}
